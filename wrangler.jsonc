{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // global_fetch_strictly_public: outbound fetch() can never reach private/internal
  // addresses, a platform-level SSRF backstop for upload_media(sourceUrl).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "folio" }],
  // Optional but recommended: pool Supabase connections at the edge.
  // Create with: npx wrangler hyperdrive create folio-db --connection-string="postgres://..."
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-id>" }],
  "vars": {
    "CF_WORKER": "1",
    "NEXT_PUBLIC_APP_NAME": "Folio",
    "NEXT_PUBLIC_ROOT_DOMAIN": "folio.example",
    "STORAGE_DRIVER": "r2"
  },
  // Secrets (wrangler secret put): APP_SECRET, DATABASE_URL, R2_ACCOUNT_ID,
  // R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET, MEDIA_PUBLIC_URL
  "routes": [
    { "pattern": "folio.example", "custom_domain": true },
    { "pattern": "*.folio.example/*", "zone_name": "folio.example" }
  ],
  "observability": { "enabled": true }
}
