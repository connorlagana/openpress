# ---- Core ----
# Public name shown in the UI.
NEXT_PUBLIC_APP_NAME=OpenPress
# Host that serves the dashboard + MCP endpoint. Sites live at <subdomain>.<this>.
# Local: localhost:3000 (sites at http://<sub>.localhost:3000). Production: e.g. openpress.blog
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Long random string. Signs confirmation tokens and analytics salts. REQUIRED in production.
APP_SECRET=

# ---- Database ----
# Production: Supabase Postgres connection string (transaction pooler, port 6543), e.g.
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local without Docker: embedded Postgres (PGlite) stored on disk.
DATABASE_URL=pglite://./.data/dev
DATABASE_POOL_MAX=5
# Production database for `pnpm deploy:cf` / `pnpm db:migrate --prod` (direct, non-pooled URL).
# Put it in .env.production.local (gitignored), not here.
# PROD_DATABASE_URL=

# ---- Sign in with Google / Apple (optional) ----
# Each button appears only when its provider is fully configured.
# Google: an OAuth "Web application" client. Authorized redirect URI: https://<ROOT_DOMAIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: a Services ID (client id) with "Sign in with Apple" enabled. Return URL: https://<ROOT_DOMAIN>/auth/apple/callback
# (Apple rejects localhost.) Key = a Sign in with Apple private key (.p8); paste the PEM with \n for newlines.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Media storage ----
# local = ./.data/media (development only). r2-binding = the Worker's MEDIA R2 binding
# (production on Cloudflare, no keys). r2 = R2 via its S3 API (needs the R2_* keys below).
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket domain (e.g. https://media.openpress.blog). If empty, media is proxied through /m/.
MEDIA_PUBLIC_URL=

# ---- Tuning (optional) ----
# PBKDF2 iterations for password hashing (default 310000).
# PASSWORD_ITERATIONS=310000

# ---- Search engines (optional) ----
# IndexNow pings (Bing, Yandex, …) when posts are published, updated or removed.
# Default: on for https hosts, off on localhost. Set off to disable, on to force.
# INDEXNOW=

# ---- Hosting ----
# Header carrying the real client IP, set by your edge (Railway: x-real-ip).
# Unset = cf-connecting-ip, then x-forwarded-for (right for Cloudflare).
IP_HEADER=
