# ---- Core ----
# Public name shown in the UI.
NEXT_PUBLIC_APP_NAME=Folio
# Host that serves the dashboard + MCP endpoint. Sites live at <subdomain>.<this>.
# Local: localhost:3000 (sites at http://<sub>.localhost:3000). Production: e.g. folio.site
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Long random string. Signs confirmation tokens and analytics salts. REQUIRED in production.
APP_SECRET=

# ---- Database ----
# Production: Supabase Postgres connection string (transaction pooler, port 6543), e.g.
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local without Docker: embedded Postgres (PGlite) stored on disk.
DATABASE_URL=pglite://./.data/dev
DATABASE_POOL_MAX=5

# ---- Media storage ----
# local = ./.data/media (development only). r2 = Cloudflare R2 via its S3 API.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket domain (e.g. https://media.folio.site). If empty, media is proxied through /m/.
MEDIA_PUBLIC_URL=

# ---- Tuning (optional) ----
# PBKDF2 iterations for password hashing (default 310000).
# PASSWORD_ITERATIONS=310000
